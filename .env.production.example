# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env
#   # then fill in every REQUIRED value below
#
# This file is read by Docker Compose, which substitutes it into the service
# definitions. Keep the real .env out of git (it already is) and off any shared
# drive — it holds your database password, token signing key and API key.

# ---------- REQUIRED ----------

# Postgres credentials. Used both to initialise the database volume on first
# boot and to build the backend's DATABASE_URL.
# Note: these are only applied when the pgdata volume is created. Changing them
# later does NOT change the existing database user's password.
POSTGRES_USER=todo
POSTGRES_PASSWORD=
POSTGRES_DB=todo_db

# JWT signing key. Anyone who knows this can mint a token for any account, so
# treat it like a private key. The backend refuses to start in production if
# this is empty, shorter than 32 characters, or left as the example placeholder.
# Generate one with:
#   docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it logs every user out, which is the point after a suspected leak.
SECRET_KEY=

# ---------- OPTIONAL ----------

# Anthropic API key. Auth and task CRUD work fully without it; the three AI
# features (natural-language add, AI re-prioritize, chat) return 503 until it
# is set. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used by all three AI features.
CLAUDE_MODEL=claude-sonnet-4-6

# Host port the app is served on. Use 80 when this container faces the internet
# directly. If you terminate TLS with nginx/Caddy/Traefik on the host, set this
# to something like 8080 and point that proxy at it — and in
# docker-compose.prod.yml bind it to 127.0.0.1 so nothing else can reach it.
WEB_PORT=80

# How long a login stays valid, in minutes (5 to 43200). Default is 7 days.
# Logging out revokes all of a user's tokens, but a stolen token stays valid
# until then, so a shorter window still limits the blast radius.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# uvicorn worker processes. A reasonable starting point is
# (2 x CPU cores) + 1; raise it only alongside DB_POOL_SIZE, since each worker
# keeps its own connection pool.
WEB_CONCURRENCY=2

# DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Where the browser sends API calls. '/api' means "same origin as the page",
# which is what the bundled nginx config serves. Change this only if the
# frontend and API are deployed to different hostnames — and then also set
# FRONTEND_ORIGINS below, because the requests become cross-origin.
VITE_API_URL=/api

# Comma-separated origins allowed to call the API cross-origin. Leave empty for
# the default same-origin setup; CORS is not involved at all there.
# Example: FRONTEND_ORIGINS=https://todo.example.com
FRONTEND_ORIGINS=
