# Keep secrets and local state out of the build context entirely — anything
# copied in is recoverable from the image, even if a later layer deletes it.
.env
.env.*
!.env.example

.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

.pytest_cache/
tests/
requirements-dev.txt

.git/
.gitignore
*.md
